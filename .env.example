# Обязательные настройки — скопируйте файл в .env и заполните
BOT_TOKEN=123456789:AAExampleTokenHere
CHANNEL_ID=@your_channel
# или ID канала в виде -100xxxxxxxxxx

# Необязательные настройки
ADMIN_CHAT_ID=
TZ=Europe/Moscow

# Как часто собирать статьи (в минутах)
COLLECT_INTERVAL_MIN=15

# Время публикаций в течение дня (по TZ), 20 постов
POST_TIMES=07:30,08:15,09:00,09:45,10:30,11:15,12:00,12:45,13:30,14:15,15:00,15:45,16:30,17:15,18:00,18:45,19:30,20:15,21:00,21:45

# Не публиковать статьи старше N часов
MAX_AGE_HOURS=30

# Порог схожести (0..1), выше которого статья считается дубликатом
DUPLICATE_THRESHOLD=0.62

# Сколько последних статей сравнивать при поиске дублей
KEEP_TOKENS_FOR=300

# Таймаут запросов к RSS и лимит записей на источник
HTTP_TIMEOUT=20
MAX_ITEMS_PER_FEED=50

LOG_LEVEL=INFO
# Если системные CA-сертификаты не подгрузились (macOS python.org) — бот сам
# использует certifi. Отключить проверку SSL можно так (только для отладки):
# SSL_VERIFY=false
# Путь к базе данных
# DB_PATH=/path/to/f1_bot.db
